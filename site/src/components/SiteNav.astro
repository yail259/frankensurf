---
// The floating navbar shared by the landing page and the benchmark page. The lab-voltage trace
// only runs on the landing page (scripts/nav.ts drives it from the hero's lightning).
import StitchedWave from "../assets/stitched-wave.svg";

interface Props { home?: boolean }
const { home = false } = Astro.props;
const repo = "https://github.com/yail259/frankensurf";
---
<header class="nav" id="nav">
  <div class="nav-shell">
    <a class="brand" href={home ? "#top" : "/"} aria-label="Frankensurf home">
      <StitchedWave class="brand-mark" aria-hidden="true" />
      <span class="brand-word">FRANKEN<span>SURF</span></span>
    </a>
    {home && (
      <div class="volt" aria-label="Lab voltage">
        <canvas id="ekg" width="120" height="28" aria-hidden="true"></canvas>
        <span class="volt-read"><b id="kv">0.0</b> kV</span>
      </div>
    )}
    <nav class="nav-actions">
      <a class="docs-link" href="/benchmarks/" data-astro-prefetch>Benchmarks</a>
      <a class="docs-link nav-blog" href="/blog/">Blog</a>
      <a class="docs-link" href="/docs/" data-astro-prefetch>Docs</a>
      <a class="gh" href={repo} aria-label="FrankenSurf on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z" /></svg>
        <span>GitHub</span>
        <span class="gh-stars"><span data-stars hidden></span><svg class="star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9z" /></svg></span>
      </a>
    </nav>
  </div>
</header>

<script>
  // Live star count on every [data-stars] on the page. GitHub's public API, cached for the
  // visit; if it can't be reached the buttons simply show the star alone.
  // The count appears from SHOW_FROM stars up, so a brand-new repo shows the star alone.
  const SHOW_FROM = 10;
  (async () => {
    const show = (n: number) => n >= SHOW_FROM && document.querySelectorAll<HTMLElement>("[data-stars]").forEach((el) => {
      el.textContent = n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : String(n);
      el.hidden = false;
    });
    let cached: string | null = null;
    try { cached = sessionStorage.getItem("fs-stars"); } catch {}
    if (cached !== null) return show(Number(cached));
    try {
      const response = await fetch("https://api.github.com/repos/yail259/frankensurf", { headers: { Accept: "application/vnd.github+json" } });
      if (!response.ok) return;
      const n = (await response.json()).stargazers_count;
      if (typeof n !== "number") return;
      try { sessionStorage.setItem("fs-stars", String(n)); } catch {}
      show(n);
    } catch {}
  })();
</script>
